{
  "name": "dsh-root-temp-guard",
  "version": "0.9.0",
  "description": "DSH Host plugin: block tool calls that create temporary directories/files in the workspace root (including the 0.2.2 apply_patch tool), with a graphical settings page. Workspace root follows the session; temp dir name, deny patterns and denial text are configurable.",
  "type": "module",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "lib",
    "vendor",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.2.1-0 <0.3.0"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "market:index": "node scripts/update-market-index.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "guard",
    "temporary-files"
  ],
  "license": "MIT",
  "author": "lizhijie429",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lizhijie429/dsh-root-temp-guard.git"
  },
  "homepage": "https://github.com/lizhijie429/dsh-root-temp-guard#readme",
  "bugs": {
    "url": "https://github.com/lizhijie429/dsh-root-temp-guard/issues"
  }
}
